# Copy to .env when you need live-mode extras. The offline demo and the
# full test suite need NONE of these — they run with zero credentials.

# Optional: enables --llm-polish (rephrases outreach drafts via an
# OpenAI-compatible chat-completions endpoint). Without it, drafts use the
# built-in template, which is the default and needs no key.
# Where to get it: https://platform.openai.com/api-keys (or any compatible
# provider) -> create key -> paste below. Never commit the real value.
LEAD_ENGINE_LLM_API_KEY=

# Optional: override the chat-completions endpoint (any OpenAI-compatible
# provider works) and model. Defaults shown.
LEAD_ENGINE_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LEAD_ENGINE_LLM_MODEL=gpt-4o-mini

# Optional: fixture/demo localhost port (must stay in 8600-8619).
FIXTURE_PORT=8607
